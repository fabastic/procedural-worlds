   },
   "trigger": {
    "type": "focus",
    "focus": "trench",
    "radius_m": 3.0
   },
   "caption": "The trench shook, and the sandbags bled snow onto the duckboards."
  },
  {
   "id": "b04",
   "scene_id": "police_station_dusk_4",
   "shot": {
    "type": "establishing",
    "focus": "lamp",
