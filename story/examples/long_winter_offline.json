   "trigger": {
    "type": "focus",
    "focus": "landmark",
    "radius_m": 3.0
   },
   "caption": "The field beyond the wire was white and perfectly quiet, the kind of quiet that made men whisper. At dusk the guns began again."
  },
  {
   "id": "b03",
   "scene_id": "battlefield_dusk_3",
   "shot": {
