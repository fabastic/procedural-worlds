   "trigger": {
    "type": "focus",
    "focus": "window",
    "radius_m": 3.0
   },
   "caption": "On Christmas Eve someone found a candle and set it on the ward's long table."
  },
  {
   "id": "b10",
   "scene_id": "kitchen_day_7",
   "shot": {
    "type": "establishing",
    "focus": "kettle",
