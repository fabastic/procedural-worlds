    "duration_s": 3.5
   },
   "trigger": {
    "type": "focus",
    "focus": "lamp",
    "radius_m": 3.0
   },
   "caption": "said the sergeant.  A shell landed short.",
   "dialogue": [
    {
     "speaker": "SERGEANT",
     "text": "Keep your head down, Weller"
    },
    {
     "speaker": "VOICE",
     "text": "Keep it down and you'll see Christmas."
    }
   ]
  },
  {
   "id": "b05",
   "scene_id": "hospital_ward_dusk_5",
   "shot": {
    "type": "establishing",
    "focus": "beds",
    "camera_move": "tilt_up",
    "duration_s": 3.5
   },
   "trigger": {
    "type": "focus",
    "focus": "beds",
    "radius_m": 3.0
   },
   "caption": "When Tomas woke he was in the field hospital ward, under a grey blanket, between rows of iron beds."
  },
  {
   "id": "b06",
   "scene_id": "hospital_ward_dusk_5",
   "shot": {
    "type": "medium",
    "focus": "window",
    "camera_move": "pull_out",
    "duration_s": 3.0
   },
   "trigger": {
    "type": "focus",
    "focus": "window",
    "radius_m": 3.0
   },
   "caption": "A nurse with tired eyes wrote his name on a board by the window. Outside, the snow kept falling on the lorries."
  },
  {
   "id": "b07",
   "scene_id": "kitchen_dusk_6",
   "shot": {
    "type": "establishing",
    "focus": "cork_board",
