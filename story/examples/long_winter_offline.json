   },
   "trigger": {
    "type": "focus",
    "focus": "counter",
    "radius_m": 3.0
   },
   "caption": "He told his mother the food was good. He told her it had stopped snowing."
  },
  {
   "id": "b09",
   "scene_id": "kitchen_dusk_6",
