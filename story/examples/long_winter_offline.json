    "duration_s": 3.5
   },
   "trigger": {
    "type": "focus",
    "focus": "cork_board",
    "radius_m": 3.0
   },
   "caption": "He wrote a letter home on the back of a ration card."
  },
  {
   "id": "b08",
   "scene_id": "kitchen_dusk_6",
   "shot": {
    "type": "high",
    "focus": "counter",
    "camera_move": "pan_left",
